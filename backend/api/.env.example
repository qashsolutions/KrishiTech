# Example environment for the api service. Copy to .env for local use and run with
#   uv run --env-file .env uvicorn app.main:app --port 8080
# The application itself reads ONLY the process environment, never a .env file.
# .env is git-ignored; this example file is committed and must hold no real values.

APP_ENV=dev
LOG_LEVEL=INFO

# Directory the api reads crop, language and region packs from at runtime.
# Data, never code: packs are not an importable package. The loader is not yet implemented;
# /readyz only checks that this directory exists.
PACKS_DIR=../../packs

# PORT is injected by Cloud Run in production. In dev, pass --port 8080 to uvicorn.
