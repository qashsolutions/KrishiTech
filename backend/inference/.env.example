# Example environment for the inference service. Copy to .env for local use and run with
#   uv run --env-file .env uvicorn app.main:app --port 8081
# The application itself reads ONLY the process environment, never a .env file.
# .env is git-ignored; this example file is committed and must hold no real values.

APP_ENV=dev
LOG_LEVEL=INFO

# PORT is injected by Cloud Run in production. In dev, pass --port 8081 to uvicorn.
